# question list for the expert, and the copy-review checklists are process
# artefacts written for one reader and phrased accordingly.
plans/
docs/
contracts/deployments/e2e-keys-*.json

# TypeScript incremental build cache.
web/tsconfig.tsbuildinfo

# Ceremony working state: the live zkey, uploads in flight, and the transcript
# the running service owns. The transcript is published over HTTP, not through
# the repo.
ceremony/data/
ceremony/.env.test
