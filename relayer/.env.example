# Printed by contracts/scripts/deploy.mjs
POOL_ADDRESS=0x...
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com

PORT=8788
HOST=127.0.0.1
NODE_ENV=production

# Hot wallet. Production refuses to start without an encrypted keystore —
# this wallet is permanently online and holds real funds.
KEYSTORE_PATH=/path/to/relayer-keystore.json
KEYSTORE_PASSWORD=

# Local development only; rejected when NODE_ENV=production.
# RELAYER_PRIVATE_KEY=0x...

# Refuse to relay when gas would eat more than this fraction of the 0.2% fee.
# At 0.1 ETH the fee is 0.0002 ETH against ~0.00002 ETH of gas, a 10x margin —
# but Orbit congestion pricing can invert that, and without this the relayer
# quietly subsidises every withdrawal until the wallet is empty.
MAX_GAS_FEE_RATIO=0.5

# Warn below this. The float is self-sustaining once withdrawals start, since
# the fee returns to the same address.
MIN_BALANCE_ETH=0.002
