# Leave VITE_POOL_ADDRESS unset to run against the simulated pool.
# Setting it switches the whole app onto the deployed contract — no other
# change is needed anywhere in the UI.

# Printed by contracts/scripts/deploy.mjs
# VITE_POOL_ADDRESS=0x...
# VITE_CHAIN_ID=4663
# VITE_DEPLOY_BLOCK=0

# VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Where the relayer is reachable from the browser. Same-origin behind a
# reverse proxy is preferable: a cross-origin relayer sees the user's IP
# alongside their withdrawal, which is the one correlation the relayer is
# supposed to be breaking.
# VITE_RELAYER_URL=/relayer

# Proving artefacts. The zkey is ~20 MB and is fetched only when a withdrawal
# starts, then cached for a year as immutable.
#
# Put the first 8 hex of the file's SHA-256 in the name. The cache headers are
# immutable, so a key that changes under a stable filename is served stale to
# every returning visitor — they would generate proofs against the retired
# verifying key and get `invalid proof` on chain, with nothing in the browser
# to suggest why. Regenerate the key, rename the file, update both lines.
# VITE_CIRCUIT_WASM=/circuit/withdraw.<sha8>.wasm
# VITE_CIRCUIT_ZKEY=/circuit/withdraw_final.<sha8>.zkey
