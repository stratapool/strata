stratapool.xyz, www.stratapool.xyz {
  encode zstd gzip

  # Same-origin on purpose. A relayer on its own hostname would receive the
  # user's IP alongside each withdrawal as a separately correlatable request.
  handle_path /relayer/* {
    reverse_proxy strata-relayer:8788
  }

  # The phase-2 ceremony. Same-origin for the same reason the relayer is: a
  # contributor's IP should not reach a second host alongside their upload.
  handle_path /ceremony/* {
    # A contribution is a ~20 MB upload and the verification behind it takes
    # about ten seconds, so the defaults time out mid-request.
    request_body {
      max_size 64MB
    }
    reverse_proxy strata-ceremony:8789 {
      transport http {
        read_timeout 300s
        write_timeout 300s
      }
    }
  }

  # The chain RPC, same-origin.
  #
  # Two things this buys. The paid endpoint's credential is its own URL path,
  # so putting it in the bundle publishes it to anyone who opens devtools and
  # hands them the quota. And every visitor's IP would otherwise reach a third
  # party alongside the exact queries this pool exists to keep unlinkable — the
  # same reason the relayer and the ceremony are same-origin. The upstream sees
  # one address, this server's, and this server keeps no log.
  #
  # The upstream URL is deliberately not in this repository. Set it in the live
  # Caddyfile on the host; this file is the reviewable copy and a public one.
  handle_path /rpc* {
    rewrite * /YOUR_PROVIDER_PATH_TOKEN/
    reverse_proxy https://YOUR_PROVIDER_HOST {
      header_up Host YOUR_PROVIDER_HOST
      transport http {
        read_timeout 60s
      }
    }
  }

  # ~20 MB and immutable; cached hard so a withdrawal is only slow once.
  @circuit path /circuit/*
  header @circuit Cache-Control "public, max-age=31536000, immutable"

  # Vite names these by content hash, so a changed file is a changed URL and
  # the old one is never asked for again.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # Everything else — index.html above all — must be revalidated every time.
  #
  # index.html was served with an ETag and no Cache-Control, which does not
  # mean "do not cache": with no explicit lifetime a browser applies heuristic
  # freshness, typically a tenth of the age since Last-Modified, and does not
  # ask again until it expires. So a visitor kept an hours-old index.html
  # pointing at hashed bundles that were themselves cached immutably, and went
  # on running superseded code with no way to notice — including through a
  # deploy that fixed the outage they were looking at. no-cache still allows
  # the cache; it requires revalidation first, which the ETag makes cheap.
  @html not path /assets/* /circuit/*
  header @html Cache-Control "no-cache"

  handle {
    root * /srv/strata
    try_files {path} /index.html
    file_server
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    -Server

    # The page holds note secrets in memory. Without a policy, one injected
    # script could read them and post them anywhere; with one, it can compute
    # but it cannot get anything out. connect-src is the load-bearing line.
    #
    # wasm-unsafe-eval: snarkjs compiles the circuit to WebAssembly to prove.
    # unsafe-inline for styles only: React writes style attributes everywhere
    # and AppKit is Lit-based. Scripts get no such exemption.
    #
    # pulse.walletconnect.org is deliberately absent. AppKit is configured
    # with analytics: false and beacons it anyway — that flag governs Reown's
    # dashboard, not the SDK's own telemetry. This is the browser enforcing a
    # property the library would not.
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://api.web3modal.org; connect-src 'self' https://api.web3modal.org wss://relay.walletconnect.com wss://relay.walletconnect.org; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  }

  # No access log. This host sees which addresses withdraw and from where;
  # writing that down manufactures exactly the records the protocol exists
  # to make impossible.
  log {
    output discard
  }
}
